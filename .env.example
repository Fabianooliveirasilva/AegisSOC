# Non-secret overrides only (docs/DEPLOYMENT.md section 2). Copy to .env to use.
# NEVER put secrets here: secrets live in infrastructure/compose/secrets/
# (generated by `make setup`) and are read through *_FILE variables.
AEGIS_ENV=local
AEGIS_SESSION_IDLE_MINUTES=30
AEGIS_SESSION_ABSOLUTE_HOURS=8
AEGIS_INGEST_MAX_RECORDS=500
AEGIS_INGEST_MAX_BODY_BYTES=1048576
AEGIS_METRICS_ENABLED=true
# AI stays off by default; Sprint 5 only.
AEGIS_AI_ENABLED=false
AEGIS_AI_PROVIDER=fixture
