#!/bin/sh
# Generate local secret files (SR-16). Never prints secret values.
#
# Usage: scripts/setup-secrets [--ci] [TARGET_DIR]
#   TARGET_DIR defaults to $AEGIS_SECRETS_DIR, else infrastructure/compose/secrets
#   --ci  also generates bootstrap_admin_password (used only by CI)
#
# Each secret is 32 random bytes, base64url without padding, written with mode
# 600 inside a mode-700 directory. Existing files are never overwritten.
# No application users are created here (the first admin comes from
# `make bootstrap-admin`).
set -eu

ci=0
target=""
for arg in "$@"; do
  case "$arg" in
    --ci) ci=1 ;;
    -*) echo "setup-secrets: unknown option: $arg" >&2; exit 2 ;;
    *) target="$arg" ;;
  esac
done

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
target=${target:-${AEGIS_SECRETS_DIR:-$root/infrastructure/compose/secrets}}

names="postgres_superuser_password postgres_owner_password postgres_app_password redis_password"
if [ "$ci" -eq 1 ]; then
  names="$names bootstrap_admin_password"
fi

umask 077
if [ ! -d "$target" ]; then
  mkdir -p "$target"
fi
chmod 700 "$target"

created=0
kept=0
for name in $names; do
  file="$target/$name"
  if [ -e "$file" ] || [ -L "$file" ]; then
    kept=$((kept + 1))
    continue
  fi
  # noclobber makes the create atomic: it fails if the file appears meanwhile.
  # The value flows only through the pipe into the file, never to stdout.
  if ( set -C; head -c 32 /dev/urandom | base64 | tr '+/' '-_' | tr -d '=\n' > "$file" ); then
    chmod 600 "$file"
    created=$((created + 1))
  else
    echo "setup-secrets: could not create $name" >&2
    exit 1
  fi
done

echo "setup-secrets: $created created, $kept already present (dir: $target)"
