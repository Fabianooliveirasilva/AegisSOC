#!/bin/sh
# Generate local secret files (SR-16). Never prints secret values.
#
# Usage: scripts/setup-secrets [--ci] [TARGET_DIR]
#   TARGET_DIR defaults to $AEGIS_SECRETS_DIR, else infrastructure/compose/secrets
#   --ci  also generates bootstrap_admin_password (used only by CI)
#
# Each secret is 32 random bytes, base64url without padding, written with mode
# 600 inside a mode-700 directory. Fails closed: the value is generated and
# validated (43 chars of [A-Za-z0-9_-]) before anything is written, with no temp
# file; the file is created and written through one descriptor; on any error
# the file created by this run is removed and the exit status is non-zero.
# Existing files are never overwritten or modified, but they are checked (regular
# file, not a symlink, mode 600, valid value); a bad one is reported by name and
# makes the script exit non-zero.
# No application users are created here (the first admin comes from
# `make bootstrap-admin`).
set -eu

ci=0
target=""
for arg in "$@"; do
  case "$arg" in
    --ci) ci=1 ;;
    -*) echo "setup-secrets: unknown option: $arg" >&2; exit 2 ;;
    *) target="$arg" ;;
  esac
done

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
target=${target:-${AEGIS_SECRETS_DIR:-$root/infrastructure/compose/secrets}}

names="postgres_superuser_password postgres_owner_password postgres_app_password redis_password"
if [ "$ci" -eq 1 ]; then
  names="$names bootstrap_admin_password"
fi

LC_ALL=C
export LC_ALL
umask 077
mkdir -p -- "$target"
chmod 700 -- "$target"

created_file=""
cleanup() {
  status=$?
  if [ "$status" -ne 0 ] && [ -n "$created_file" ]; then
    rm -f -- "$created_file"
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

# valid_value VALUE: exactly 43 base64url characters (32 bytes, no padding).
valid_value() {
  case $1 in
    ''|*[!A-Za-z0-9_-]*) return 1 ;;
  esac
  [ "${#1}" -eq 43 ]
}

# b64char INDEX: sets $ch to the INDEX-th base64url character (shell builtins
# only, so no value derived from the secret ever reaches an argv).
b64char() {
  rest="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
  i=$1
  while [ "$i" -gt 0 ]; do
    rest=${rest#?}
    i=$((i - 1))
  done
  ch=${rest%"${rest#?}"}
}

# generate: sets $secret_value or returns 1. There is no temp file and no
# pipeline: od is a single command whose exit status is checked, its decimal
# output is split into exactly 32 bytes, and the base64url encoding (no
# padding) is done with shell arithmetic. A failed, short or empty read gives
# fewer than 32 numbers and fails closed.
generate() {
  secret_value=""
  raw=$(od -An -v -N 32 -tu1 /dev/urandom) || return 1
  # shellcheck disable=SC2086
  set -- $raw
  raw=""
  [ "$#" -eq 32 ] || return 1
  out=""
  while [ "$#" -ge 3 ]; do
    n=$(($1 * 65536 + $2 * 256 + $3))
    shift 3
    for sh_ in 18 12 6 0; do
      b64char $(((n >> sh_) & 63))
      out="$out$ch"
    done
  done
  if [ "$#" -eq 2 ]; then
    n=$(($1 * 65536 + $2 * 256))
    for sh_ in 18 12 6; do
      b64char $(((n >> sh_) & 63))
      out="$out$ch"
    done
  fi
  n=0
  set --
  secret_value=$out
  out=""
  valid_value "$secret_value"
}

# SEC-12: remembers values of this run to refuse an obviously constant RNG.
seen=" "

created=0
kept=0
bad=0
for name in $names; do
  file="$target/$name"
  if [ -e "$file" ] || [ -L "$file" ]; then
    problem=""
    if [ -L "$file" ]; then
      problem="is a symlink"
    elif [ ! -f "$file" ]; then
      problem="is not a regular file"
    elif [ -z "$(find "$file" -prune -perm 600 2>/dev/null)" ]; then
      problem="does not have mode 600"
    elif [ ! -s "$file" ]; then
      problem="is empty"
    else
      existing=$(cat -- "$file") || existing=""
      if ! valid_value "$existing" || [ "$(wc -c < "$file")" -ne 43 ]; then
        problem="does not hold a valid 43-character secret"
      fi
      existing=""
    fi
    if [ -n "$problem" ]; then
      echo "setup-secrets: ERROR: existing file $file $problem; left unmodified (fix or remove it manually)" >&2
      bad=$((bad + 1))
    else
      kept=$((kept + 1))
    fi
    continue
  fi

  if ! generate; then
    echo "setup-secrets: ERROR: could not generate a valid value for $name" >&2
    exit 1
  fi
  case $seen in
    *" $secret_value "*)
      echo "setup-secrets: ERROR: random source produced a duplicate value; refusing" >&2
      exit 1 ;;
  esac
  seen="$seen$secret_value "
  # One open for create and write: noclobber makes the open O_EXCL (it fails if
  # the path exists, even as a symlink, and then the file is not ours and is not
  # removed). The value is written through that same descriptor, so a path swap
  # after the create cannot redirect the write. A failing exec redirection
  # aborts a non-interactive shell with a non-zero status (fail closed).
  set -C
  if ! { exec 3> "$file"; } 2>/dev/null; then
    set +C
    echo "setup-secrets: ERROR: could not create $name (path appeared concurrently?)" >&2
    exit 1
  fi
  set +C
  created_file="$file"
  # The file was created under umask 077, i.e. already mode 600; no chmod by
  # path is needed (it would follow a swapped-in symlink).
  # printf is a shell builtin: the value never appears in argv or on stdout.
  printf '%s' "$secret_value" >&3 || { echo "setup-secrets: ERROR: could not write $name" >&2; exit 1; }
  exec 3>&-
  secret_value=""
  created_file=""
  created=$((created + 1))
done

echo "setup-secrets: $created created, $kept already present (dir: $target)"
if [ "$bad" -ne 0 ]; then
  echo "setup-secrets: $bad existing file(s) failed validation (see errors above)" >&2
  exit 1
fi
